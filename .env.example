# Public browser configuration only. Never place secrets in REACT_APP_* variables.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Reserved provider settings for later phases.
REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_AUTH_GOOGLE_CLIENT_ID=replace-with-public-client-id
REACT_APP_AUTH_APPLE_CLIENT_ID=replace-with-public-service-id
REACT_APP_PUSH_PUBLIC_KEY=replace-with-public-vapid-key

# AI keys, OAuth client secrets, database credentials, email credentials and
# push private keys belong in the future trusted backend, not this file.
